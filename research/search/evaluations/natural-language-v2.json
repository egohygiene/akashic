{
  "schemaVersion": 2,
  "id": "akashic-natural-language-v2",
  "description": "A stratified extension of the v1 seed with graded per-resource judgments, explicit assessment provenance, multilingual and accessibility cases, and a catalog-coverage gap.",
  "topK": 10,
  "extends": "natural-language-v1.json",
  "extendsSha256": "209f67722794fc103e69cdce20b1c6bdcc8e40187fafd1ab0da18f0b9f8de066",
  "reviewProtocol": {
    "id": "akashic-graded-relevance-v1",
    "minimumRelevantGrade": 2,
    "legacyBinaryRelevantGrade": 2,
    "grades": [
      {
        "value": 0,
        "label": "known-irrelevant",
        "definition": "Does not help answer this query and is safe to use as a query-relative negative probe."
      },
      {
        "value": 1,
        "label": "related-but-insufficient",
        "definition": "Topically related, but it does not provide the requested pathway by itself."
      },
      {
        "value": 2,
        "label": "useful-pathway",
        "definition": "Provides a useful pathway that materially advances the stated need."
      },
      {
        "value": 3,
        "label": "direct-primary-pathway",
        "definition": "Directly satisfies the query or is the primary authoritative starting point."
      }
    ],
    "agreement": {
      "minimumIndependentAssessors": 2,
      "automaticResolution": "exact-grade-only",
      "conflictResolution": "adjudicated-grade-required"
    }
  },
  "assessors": [
    {
      "id": "legacy-v1-curation",
      "kind": "versioned-source",
      "independent": false,
      "scope": "Judgments inherited from akashic-natural-language-v1.",
      "provenance": "The v1 binary fixture and its merged Git history; relevant judgments map conservatively to grade 2 and known-irrelevant judgments map to grade 0."
    },
    {
      "id": "v2-curation-proposal",
      "kind": "curation-proposal",
      "independent": false,
      "scope": "Cases introduced by akashic-natural-language-v2.",
      "provenance": "Repository-authored proposal for pull-request review; it is not counted as an independent human assessment."
    }
  ],
